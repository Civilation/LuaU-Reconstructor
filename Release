local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TextChatService = game:GetService("TextChatService")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local HOME = ServerScriptService
local seen = {}
local NIL_MARKER = {}

local JUNK = {
	0, -1, 1, 2147483647, -2147483648, 999999999, math.huge, -math.huge, 0/0,
	"", "\0", string.rep("A", 4096), "%s", "%d", "..", "./..", "../..",
	true, false,
	{}, {1,2,3}, {["__x"] = true}, {[1] = {}}, {{}}, {n = 1e9},
	Vector3.zero, Vector3.new(math.huge, -math.huge, 0/0),
	CFrame.new(), CFrame.Angles(0/0, 0/0, 0/0),
	Color3.new(), BrickColor.new("Really red"),
	NIL_MARKER,
}

local function junkAt(i)
	local v = JUNK[((i - 1) % #JUNK) + 1]
	if v == NIL_MARKER then return nil end
	if type(v) == "table" then
		local c = {}
		for k, val in pairs(v) do c[k] = val end
		return c
	end
	return v
end

local function ensureFolder(parent, name)
	local f = parent:FindFirstChild(name)
	if f then
		if f:IsA("Folder") then return f end
		return nil
	end
	local nf = Instance.new("Folder")
	nf.Name = name
	nf.Parent = parent
	return nf
end

local function appendTrace(node, text)
	local sv = node:FindFirstChild("__trace")
	if sv and sv:IsA("StringValue") then
		if not sv.Value:find(text, 1, true) then
			if #sv.Value > 65536 then
				sv.Value = text
			else
				sv.Value = sv.Value .. "\n---\n" .. text
			end
		end
		return
	end
	sv = Instance.new("StringValue")
	sv.Name = "__trace"
	sv.Value = text
	sv.Parent = node
end

local function materialize(segments, trace, source)
	if #segments == 0 then return nil end
	for _, s in ipairs(segments) do
		if not s:match("^[%w_]+$") then return nil end
	end

	local key = table.concat(segments, ".")
	local rec = seen[key]
	if rec then
		rec.hits += 1
		rec.node:SetAttribute("Recon_Hits", rec.hits)
		if trace then appendTrace(rec.node, trace) end
		if source then rec.node:SetAttribute("Recon_Src_" .. source, true) end
		return rec.node
	end

	local cur = HOME
	for i = 1, #segments - 1 do
		local f = ensureFolder(cur, segments[i])
		if not f then return nil end
		cur = f
	end

	local leaf = segments[#segments]
	local existing = cur:FindFirstChild(leaf)
	if existing then
		existing:SetAttribute("Recon_Hits", 1)
		if trace then appendTrace(existing, trace) end
		if source then existing:SetAttribute("Recon_Src_" .. source, true) end
		seen[key] = { node = existing, hits = 1 }
		return existing
	end

	local scr = Instance.new("Script")
	scr.Name = leaf
	scr:SetAttribute("Recon_Hits", 1)
	scr:SetAttribute("Recon_Path", key)
	if source then scr:SetAttribute("Recon_Src_" .. source, true) end
	scr.Parent = cur
	if trace then appendTrace(scr, trace) end

	seen[key] = { node = scr, hits = 1 }
	return scr
end

local function scanString(text, source)
	if type(text) ~= "string" then return 0 end
	if #text < 16 or #text > 65536 then return 0 end
	if not text:find("ServerScriptService", 1, true)
		and not text:find("serverscriptservice", 1, true) then
		return 0
	end

	local added = 0
	for match in text:gmatch("[Ss]erver[Ss]cript[Ss]ervice[%.:/][%w_%.%/]+") do
		local cleaned = match:gsub("[/:]", ".")
		local segs = {}
		for part in cleaned:gmatch("[%w_]+") do
			table.insert(segs, part)
		end
		if #segs >= 3 and segs[1]:lower() == "serverscriptservice" then
			local path = {}
			for i = 2, #segs do
				table.insert(path, segs[i])
			end
			local key = table.concat(path, ".")
			local before = seen[key]
			local node = materialize(path, text, source)
			if node and not before then
				added += 1
			end
		end
	end
	return added
end

local function scanValue(v, source, depth)
	depth = depth or 0
	if depth > 6 then return 0 end
	local t = typeof(v)
	if t == "string" then
		return scanString(v, source)
	elseif t == "table" then
		local n = 0
		for k, val in pairs(v) do
			if type(k) == "string" then
				n += scanString(k, source)
			end
			n += scanValue(val, source, depth + 1)
		end
		return n
	elseif t == "Instance" then
		local n = scanString(v.Name, source)
		local ok, full = pcall(function() return v:GetFullName() end)
		if ok and type(full) == "string" then
			n += scanString(full, source)
		end
		local okTags, tags = pcall(function() return CollectionService:GetTags(v) end)
		if okTags then
			for _, tag in ipairs(tags) do
				n += scanString(tag, source)
			end
		end
		return n
	end
	return 0
end

local function scanAttributes(inst, source)
	local n = 0
	local ok, attrs = pcall(function() return inst:GetAttributes() end)
	if not ok or type(attrs) ~= "table" then return 0 end
	for name, value in pairs(attrs) do
		if type(value) == "string" then
			n += scanString(value, source)
		end
		n += scanString(name, source)
	end
	return n
end

local probed = {}
local function probeRF(rf, rounds)
	rounds = rounds or 24
	local gained = 0
	for round = 1, rounds do
		local count = math.random(0, 6)
		local args = table.create(count)
		for i = 1, count do
			args[i] = junkAt(round * 13 + i)
		end
		local ok, res = pcall(function()
			return rf:InvokeServer(table.unpack(args, 1, count))
		end)
		if not ok and type(res) == "string" then
			gained += scanString(res, "rf_error")
		elseif ok then
			gained += scanValue(res, "rf_return")
		end
		task.wait(0.03)
	end
	return gained
end

local function hookRF(rf)
	if rf:GetAttribute("__recon_rf") then return end
	rf:SetAttribute("__recon_rf", true)

	local original = rf.OnClientInvoke
	rf.OnClientInvoke = function(...)
		local args = table.pack(...)
		for i = 1, args.n do
			scanValue(args[i], "rf_incoming")
		end
		if type(original) == "function" then
			return original(...)
		end
		return nil
	end

	if not probed[rf] then
		probed[rf] = true
		task.spawn(function()
			task.wait(0.4 + math.random() * 1.5)
			probeRF(rf)
		end)
	end
end

local function hookRE(re)
	if re:GetAttribute("__recon_re") then return end
	re:SetAttribute("__recon_re", true)
	re.OnClientEvent:Connect(function(...)
		local args = table.pack(...)
		for i = 1, args.n do
			scanValue(args[i], "re_event")
		end
	end)
end

local function hookInstance(inst)
	if inst:IsA("RemoteFunction") then
		hookRF(inst)
	elseif inst:IsA("RemoteEvent") or inst:IsA("UnreliableRemoteEvent") then
		hookRE(inst)
	end

	scanValue(inst, "replicated")
	scanAttributes(inst, "attribute")

	inst.AttributeChanged:Connect(function(name)
		local ok, v = pcall(function() return inst:GetAttribute(name) end)
		if ok then scanValue(v, "attribute_change") end
		scanString(name, "attribute_change")
	end)

	if inst:IsA("StringValue") or inst:IsA("ObjectValue") then
		inst.Changed:Connect(function()
			scanValue(inst.Value, "value_change")
		end)
	end
end

local ROOTS = { ReplicatedStorage, workspace, Players }

local function sweep()
	for _, root in ipairs(ROOTS) do
		for _, d in ipairs(root:GetDescendants()) do
			hookInstance(d)
		end
	end
end

local function startEngine()
	sweep()

	for _, root in ipairs(ROOTS) do
		root.DescendantAdded:Connect(hookInstance)
	end

	for _, tag in ipairs(CollectionService:GetAllTags()) do
		scanString(tag, "tag")
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			scanValue(inst, "tagged")
		end
	end

	task.spawn(function()
		while true do
			task.wait(3)
			for _, root in ipairs(ROOTS) do
				for _, d in ipairs(root:GetDescendants()) do
					scanAttributes(d, "attr_sweep")
					if d:IsA("StringValue") then
						scanString(d.Value, "sv_sweep")
					end
				end
			end
		end
	end)

	pcall(function()
		TextChatService.MessageReceived:Connect(function(msg)
			pcall(function()
				scanString(msg.Text, "chat")
			end)
		end)
	end)
end

local Recon = {}
Recon.seen = seen
Recon.started = false

function Recon.start()
	if Recon.started then return end
	Recon.started = true
	startEngine()
end

function Recon.sweep() sweep() end

function Recon.probe(rf, rounds)
	if rf and rf:IsA("RemoteFunction") then
		return probeRF(rf, rounds or 32)
	end
	return 0
end

function Recon.scan(text, source)
	return scanString(text, source or "manual")
end

function Recon.scanDeep(v, source)
	return scanValue(v, source or "manual")
end

function Recon.tree()
	local out = {}
	for key, rec in pairs(seen) do
		out[#out+1] = { path = key, hits = rec.hits, class = rec.node.ClassName }
	end
	table.sort(out, function(a, b) return a.hits > b.hits end)
	return out
end

function Recon.note(path)
	local segs = {}
	for part in tostring(path):gmatch("[%w_]+") do
		table.insert(segs, part)
	end
	if segs[1] and segs[1]:lower() == "serverscriptservice" then
		table.remove(segs, 1)
	end
	return materialize(segs, "manual :: " .. tostring(path), "manual")
end

_G.Recon = Recon

local function buildUI()
	local existing = CoreGui:FindFirstChild("ServerScriptReconstructor")
	if existing then existing:Destroy() end

	local gui = Instance.new("ScreenGui")
	gui.Name = "ServerScriptReconstructor"
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 1000
	gui.Parent = CoreGui

	local scale = Instance.new("UIScale")
	scale.Name = "AutoScale"
	scale.Parent = gui

	local function updateScale()
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
		local baseW, baseH = 342, 267
		local padW, padH = 40, 40
		local sx = (viewport.X - padW) / baseW
		local sy = (viewport.Y - padH) / baseH
		local s = math.min(sx, sy, 1.35)
		if s < 0.5 then s = 0.5 end
		scale.Scale = s
	end

	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateScale()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
		end
	end)

	local frame = Instance.new("Frame")
	frame.Name = "UI"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = Color3.fromRGB(26, 27, 32)
	frame.Size = UDim2.new(0, 342, 0, 267)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.BorderColor3 = Color3.fromRGB(0, 0, 0)
	frame.Active = true
	frame.Draggable = true
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(54, 56, 66)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "LabelType"
	label.TextWrapped = true
	label.BorderSizePixel = 0
	label.TextSize = 19
	label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	label.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.BackgroundTransparency = 1
	label.RichText = true
	label.Size = UDim2.new(0, 313, 0, 171)
	label.BorderColor3 = Color3.fromRGB(0, 0, 0)
	label.Position = UDim2.new(0.05481, 0, 0.03172, 0)
	label.Text = [[<font face="GothamBold" size="20" color="#FFFFFF">Thanks for using</font>
<font face="GothamBold" size="20" color="#A970FF">ServerScript Reconstructor</font>

<font face="GothamMedium" size="15" color="#FFD166">#1 ServerScript Reconstructor</font>

<font face="Gotham" size="15" color="#FFFFFF">Developed by <font color="#6EE7B7"><b>Civil</b></font></font>

<font face="Gotham" size="15" color="#FFFFFF">Thanks for choosing ServerScript Reconstructor.</font>]]
	label.Parent = frame

	local btn1 = Instance.new("TextButton")
	btn1.Name = "BTN"
	btn1.BorderSizePixel = 0
	btn1.TextSize = 17
	btn1.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn1.BackgroundColor3 = Color3.fromRGB(52, 96, 255)
	btn1.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	btn1.Size = UDim2.new(0, 321, 0, 23)
	btn1.BorderColor3 = Color3.fromRGB(0, 0, 0)
	btn1.Text = "Continue without running"
	btn1.Position = UDim2.new(0.03086, 0, 0.73358, 0)
	btn1.Parent = frame

	local c1 = Instance.new("UICorner")
	c1.CornerRadius = UDim.new(0, 5)
	c1.Parent = btn1

	local btn2 = Instance.new("TextButton")
	btn2.Name = "BTN"
	btn2.BorderSizePixel = 0
	btn2.TextSize = 17
	btn2.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn2.BackgroundColor3 = Color3.fromRGB(52, 96, 255)
	btn2.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	btn2.Size = UDim2.new(0, 321, 0, 23)
	btn2.BorderColor3 = Color3.fromRGB(0, 0, 0)
	btn2.Text = "Continue & Run"
	btn2.Position = UDim2.new(0.03086, 0, 0.85717, 0)
	btn2.Parent = frame

	local c2 = Instance.new("UICorner")
	c2.CornerRadius = UDim.new(0, 5)
	c2.Parent = btn2

	btn1.MouseButton1Click:Connect(function()
		gui:Destroy()
	end)

	btn2.MouseButton1Click:Connect(function()
		Recon.start()
		gui:Destroy()
	end)

